            "default": "pt-BR"
          },
          "idiomas_extras": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Idiomas Extras"
          },
          "preset": {
            "type": "string",
            "title": "Preset",
            "default": "padrao"
          },
          "kit": {
            "type": "string",
