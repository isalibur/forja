            "type": "string",
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo",
            "default": "longo"
          },
          "roteiro": {
            "type": "string",
            "title": "Roteiro",
            "default": ""
          },
          "idioma_principal": {
            "type": "string",
