# Copie este arquivo para .env e preencha. Nunca envie o .env para o git.

# LLM principal: o seu 9Router (endpoint compatível com OpenAI)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=            # só se o seu 9Router exigir chave para clientes
NINEROUTER_COMBO=              # nome do combo/modelo configurado no 9Router

# Reserva opcional
OPENROUTER_API_KEY=

# Acervos e dados (chaves gratuitas)
PEXELS_API_KEY=
PIXABAY_API_KEY=
EUROPEANA_API_KEY=
SMITHSONIAN_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=
OPENTOPOGRAPHY_API_KEY=
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# Local
DOCFORJA_LOCAL_TOKEN=          # gerar: python -c "import secrets;print(secrets.token_urlsafe(32))"
WIKIMEDIA_USER_AGENT=DocForja/0.1 (contato: seu-email)
